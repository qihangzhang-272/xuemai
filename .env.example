# 需要 Node.js 24，使用该版本内置 SQLite。
# 以下配置全部属于学脉，运行时不读取其他项目目录。
XUEMAI_DATA_DIR=".xuemai-data"
QWEN_API_KEY=""
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen3.6-flash"
MINERU_API_TOKEN=""
MINERU_API_BASE_URL="https://mineru.net/api/v4"
# 只有在 HTTPS 反向代理部署时设置。
XUEMAI_HTTPS="false"
# 反向代理的外部来源，默认使用请求实际 Host。
XUEMAI_ORIGIN=""
