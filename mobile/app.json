{
  "expo": {
    "name": "学脉 AI",
    "slug": "xuemai-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "xuemai-ai",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.studypulse.xuemai",
      "infoPlist": {
        "NSCameraUsageDescription": "学脉 AI 需要使用相机来拍摄作业、试卷和错题图片。",
        "NSPhotoLibraryUsageDescription": "学脉 AI 需要访问相册来选择作业、试卷和错题图片。"
      }
    },
    "android": {
      "package": "com.studypulse.xuemai",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F7F8F4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
      "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F8F4"
        }
      ]
    ]
  }
}
